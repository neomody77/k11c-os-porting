diff --git a/services/gpuservice/tests/unittests/GpuWorkRegressionTest.cpp b/services/gpuservice/tests/unittests/GpuWorkRegressionTest.cpp
new file mode 100644
--- /dev/null
+++ b/services/gpuservice/tests/unittests/GpuWorkRegressionTest.cpp
@@ -0,0 +1,18 @@
+// SPDX-License-Identifier: Apache-2.0
+#include <android-base/properties.h>
+#include <gtest/gtest.h>
+#include <gpuwork/GpuWork.h>
+#include <unistd.h>
+
+TEST(GpuWorkRegression, MissingPinnedMapDoesNotAbort) {
+    if (access("/sys/fs/bpf/map_gpuWork_gpu_work_map", F_OK) == 0) {
+        GTEST_SKIP() << "Requires a device without the GPU work map";
+    }
+    ASSERT_EQ(0u, getuid());
+    ASSERT_EQ("1", android::base::GetProperty("bpf.progs_loaded", ""));
+    android::gpuwork::GpuWork work;
+    work.initialize();
+    std::string result;
+    work.dump({}, &result);
+    EXPECT_EQ("GPU work information is not available.\n", result);
+}
