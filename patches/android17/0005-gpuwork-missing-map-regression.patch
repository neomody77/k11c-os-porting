+// Regression for factory kernels without the optional GPU work BPF map.
+cc_test {
+    name: "k11c_gpuwork_regression_test",
+    srcs: ["GpuWorkRegressionTest.cpp"],
+    header_libs: ["bpf_headers"],
+    compile_multilib: "64",
+    shared_libs: ["libbase", "libbinder", "libgpuwork", "libstatssocket", "libutils"],
